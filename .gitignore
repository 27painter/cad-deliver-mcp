# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Editable install artefacts
*.pth
src/*.egg-link

# Test and benchmark output
delivery.json

# Backups created by hand
*.bak-*

# OS
Thumbs.db
.DS_Store

# Generated fixtures are reproducible: generate_fixtures.py and mutate.py rebuild
# them from the committed scripts, so 35 DXFs do not belong in git. The real
# exports in fixtures/real/ are NOT ignored - they cannot be regenerated, and they
# are what proves the benchmark is not working on synthetic data alone.
benchmarks/__pycache__/
benchmarks/fixtures/gen/*.dxf
benchmarks/fixtures/mutated/*.dxf
!benchmarks/fixtures/gen/.gitkeep
!benchmarks/fixtures/mutated/.gitkeep

# The manifest, the task list and the result tables ARE committed: they are the
# evidence behind every number reported.

# Agent repair-experiment working copies (regenerate with the steps in benchmarks/agent)
benchmarks/agent/work/
benchmarks/agent/work_complex/

# Generated by benchmarks/agent/complex_fixtures.py, byte-for-byte reproducible.
benchmarks/agent/complex_fixtures/*.dxf

# SolidWorks parts gathered for batch export (inputs, not artefacts).
tmp_sw_parts/
_fmt_*.dxf
_ps_*.dxf
_probe*.dxf
_tbt.dxf
# one-off COM probes
_layer_test.dxf
_layer_test.py

# Rendered PNGs: rebuilt by scripts/render_dxf_png.py
benchmarks/renders/
# VLM answers collected offline before scoring
benchmarks/vlm_answers.jsonl
# artefacts written into the repo root by tests/test_parsers.py
a3.pdf
blank.dwg
corrupt.dxf
corrupt.pdf
sample.dxf
two_page.pdf

# Human-eval case files: rebuilt by scripts/build_human_eval.py
benchmarks/human_eval/cad/
benchmarks/human_eval/png/

# Paper: the sources are committed (main.tex, supplementary.tex, references.bib,
# asmejour.cls/.bst/.css) so anyone can rebuild it. The build products are not:
# a PDF committed to git goes stale silently and nobody notices which revision it
# describes. The release PDF is attached to the GitHub release instead.
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.toc
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
paper/*.pdf

# Internal writing outline: working notes with the paper's own audit trail, not
# documentation. Kept out of the repository on purpose.
paper_outline_zh.md

# Submission bundles are build products: the zips are regenerated from the
# committed sources by recompiling, and a 1.2 MB archive in git is a file nobody
# can diff. The upload instructions live in the repository only as prose.
paper/submissions/
